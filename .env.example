# Copy to .env before running docker compose.

# --- Compose network ---
# Pinned so the gateway's SSRF allowlist can name this stack's subnet exactly
# instead of having to allow every private network. Change it only if it
# collides with something else on this machine, and recreate afterwards:
#   docker compose down && docker compose up -d
# (a live Docker network's subnet cannot be edited in place)
STACK_SUBNET=172.28.0.0/16

# --- Network exposure ---
# 0.0.0.0 publishes every service on all interfaces, so other machines on your
# LAN can reach them. Use 127.0.0.1 to keep everything local, or a specific NIC
# address (e.g. 192.168.1.50) to expose on one network only.
BIND_ADDR=0.0.0.0
# Optional. Only needed if you want the helper scripts and docs to use a fixed
# address instead of auto-detecting it.
LAN_IP=

# --- Postgres ---
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_dev_password
POSTGRES_DB=addressbook
POSTGRES_PORT=5432

# --- Address API ---
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
SEED_COUNT=100
# Bootstrap accounts, created only while the users table is still empty. Editing
# these later does nothing; change the account itself instead (UI, or
# PUT /api/users/:id), or recreate the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
EDITOR_PASSWORD=editor123
# Change MCP_PASSWORD below to match whenever you change this: the MCP server
# signs in as `viewer`, and the two drifting apart is a 401 on every tool call.
VIEWER_PASSWORD=viewer123

# --- Address UI ---
UI_PORT=8080

# --- MCP Server ---
MCP_HTTP_PORT=4100
# Fallback identity for MCP callers that present no JWT (stdio hosts, gateway
# probes). Keep this least-privileged: an agent should normally inherit the
# signed-in user's token instead.
MCP_USERNAME=viewer
MCP_PASSWORD=viewer123

# --- MCP Client ---
MCP_CLIENT_PORT=4200
MCP_CLIENT_UI_PORT=8081
AGENT_MAX_STEPS=6
# The assistant streams progress while it works. These bound how long each part
# may take before it is reported as failed rather than left hanging.
AGENT_HEARTBEAT_MS=10000
AGENT_TIMEOUT_MS=600000
OLLAMA_TIMEOUT_MS=180000
MCP_TOOL_TIMEOUT_MS=60000

# --- Ollama ---
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- IBM MCP Context Forge (gateway) ---
GATEWAY_PORT=4444
GATEWAY_ADMIN_USER=admin
GATEWAY_ADMIN_EMAIL=admin@example.com

# LENGTH MATTERS HERE. The gateway validates these at startup and exits if they
# are too short, which shows up as cf-gateway restarting forever rather than as
# an obvious error. Minimums:
#   GATEWAY_JWT_SECRET         32 chars  (gateway JWT_SECRET_KEY)
#   GATEWAY_ENCRYPTION_SECRET  32 chars  (gateway AUTH_ENCRYPTION_SECRET)
#   GATEWAY_ADMIN_PASSWORD     22 chars  (PASSWORD_MIN_LENGTH_PRIVILEGED)
#
# Generate real values with:
#   openssl rand -hex 32
# or, on Windows without openssl:
#   powershell -Command "[guid]::NewGuid().ToString('N') * 2"
#
# Run docker-stack/check-env.ps1 to verify before starting the stack.
GATEWAY_JWT_SECRET=replace-me-32-plus-chars-0000000000000000
GATEWAY_ENCRYPTION_SECRET=replace-me-32-plus-chars-1111111111111111
GATEWAY_ADMIN_PASSWORD=replace-me-22-plus-chars--
